{
  "name": "pi-browser",
  "version": "0.0.0",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions/browser/index.ts"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test:unit": "node --import tsx --test test/unit/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 test/integration/*.test.ts",
    "test:smoke": "node --import tsx --test test/smoke/*.test.ts",
    "test": "npm run test:unit && npm run test:integration && npm run test:smoke",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "agent-browser": "0.35.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-tui": "0.84.3",
    "tsx": "4.20.5",
    "typebox": "1.0.12",
    "typescript": "5.9.2"
  }
}
